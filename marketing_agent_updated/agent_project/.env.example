# --- Model access (same three values the smoke test uses) ---
METERLESS_BASE_URL=your-meterless-provider-address
METERLESS_API_KEY=your-meterless-key
NEMOTRON_MODEL=the-nemotron-model-id-from-meterless

# --- Backend / data ---
BACKEND_BASE_URL=http://localhost:8000
SAMPLE_MODE=false          # true = never call the backend, use built-in sample data
MOCK_SCENARIO=normal       # normal | conflict | sparse  (used by sample data and mock_server.py)

# --- Testing without the model ---
MOCK_LLM=false             # true = canned model replies, no API calls, no key needed

# --- Limits (all runs are bounded) ---
LLM_TIMEOUT_S=45
LLM_RETRIES=2
LLM_MAX_TOKENS=1500
TOOL_TIMEOUT_S=5
TOOL_RETRIES=1
MAX_REVISIONS=2
MAX_TOOL_STEPS=6
RUN_TIMEOUT_S=180

# Optional text prepended to every system prompt, e.g. a reasoning on/off switch
# if your Nemotron version supports one (check the model card).
SYSTEM_PREFIX=
